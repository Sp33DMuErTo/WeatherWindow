<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/weather_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="visible"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/weather_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_overlay"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="11dp">

        <LinearLayout
            android:id="@+id/widget_top_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/gps_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textColor="#8EDBFF"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="3dp"
                        android:visibility="gone"
                        android:contentDescription="Locație GPS" />
                    <TextView
                        android:id="@+id/location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="WeatherWindow"
                        android:textColor="#F7FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/weather_animation"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="124dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Animație meteo" />
                    <TextView
                        android:id="@+id/precipitation_probability"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="--%"
                        android:textColor="#85CDF2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/condition"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Se pregătește prognoza…"
                        android:textColor="#DCEAF4"
                        android:textSize="12sp"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">
        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            android:text="Se simte --°  •  Umiditate --%  •  Vânt -- km/h"
            android:textColor="#C2D4E2"
            android:textSize="9sp"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="1dp"
            android:background="#547084" />
        <TextView
            android:id="@+id/hourly_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="PROGNOZĂ ORARĂ · 6 H"
            android:textColor="#AFC8DA"
            android:textSize="8sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hourly_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="1dp">
            <TextView
                android:id="@+id/hourly_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/hourly_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/hourly_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/hourly_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/hourly_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/hourly_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--:--\n--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:background="#547084" />
        <TextView
            android:id="@+id/daily_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="URMĂTOARELE 6 ZILE"
            android:textColor="#AFC8DA"
            android:textSize="8sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/daily_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="1dp">
            <TextView
                android:id="@+id/daily_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/daily_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/daily_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/daily_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/daily_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/daily_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--\n--°/--°\n🌤️ --%"
                android:textColor="#F0F5F8"
                android:textSize="8sp"
                android:lineSpacingExtra="0dp"
                android:includeFontPadding="false" />
        </LinearLayout>
        </LinearLayout>

    <ImageButton
        android:id="@+id/refresh_weather"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="7dp"
        android:padding="7dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_popup_sync"
        android:tint="#FFFFFF"
        android:contentDescription="Actualizează vremea" />
    <ProgressBar
        android:id="@+id/refresh_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:padding="0dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone"
        android:contentDescription="Se actualizează vremea" />

    </FrameLayout>
</FrameLayout>
